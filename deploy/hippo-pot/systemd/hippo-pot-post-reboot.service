[Unit]
Description=Hippo-Pot post-reboot acceptance verification
After=network.target
# Run once after boot, only if the pre-reboot state file exists
ConditionPathExists=%h/.local/state/hungry-hippa/hippo-pot-pre-reboot.json

[Service]
Type=oneshot
ExecStart=%h/hungry-hippa/.venv/bin/python %h/hungry-hippa/deploy/hippo-pot/post-reboot-verify.py
Environment=PATH=/usr/bin:/bin:%h/.local/bin
Environment=PYTHONPATH=%h/hungry-hippa/src
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_DATA_HOME=%h/.local/share
Environment=XDG_STATE_HOME=%h/.local/state

[Install]
WantedBy=default.target
